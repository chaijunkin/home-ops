      "id": 20,
      "options": {
        "content": "<style>\n.perf-pill {\n  transition: all 0.15s ease;\n}\n.perf-pill:hover {\n  background: #2a313d !important;\n  color: #ffffff !important;\n}\n.perf-pill[data-perf=\"${conv_metric}\"] {\n  background: #2563eb !important;\n  color: #ffffff !important;\n  border-color: #3b82f6 !important;\n  font-weight: 700 !important;\n}\n</style>\n<div style=\"display: flex; align-items: center; gap: 8px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 3px 0; height: 100%;\">\n  <span style=\"font-size: 11px; font-weight: 700; color: #8e9bb0; text-transform: uppercase; letter-spacing: 0.05em; margin-right: 2px;\">Conversation Metric:</span>\n  <span style=\"background: #3274d9; color: #ffffff; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-right: 8px;\">Active: ${conv_metric}</span>\n  <button type=\"button\" class=\"perf-pill\" data-perf=\"Activity\" onclick=\"setParam('var-conv_metric', 'Activity', event); return false;\" style=\"display: inline-flex; align-items: center; padding: 4px 14px; border-radius: 12px; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid #333842; background: #1c2027; color: #a6b2c4; margin-right: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.2);\">Activity</button><button type=\"button\" class=\"perf-pill\" data-perf=\"Tokens\" onclick=\"setParam('var-conv_metric', 'Tokens', event); return false;\" style=\"display: inline-flex; align-items: center; padding: 4px 14px; border-radius: 12px; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid #333842; background: #1c2027; color: #a6b2c4; margin-right: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.2);\">Tokens</button><button type=\"button\" class=\"perf-pill\" data-perf=\"Estimated cost\" onclick=\"setParam('var-conv_metric', 'Estimated cost', event); return false;\" style=\"display: inline-flex; align-items: center; padding: 4px 14px; border-radius: 12px; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid #333842; background: #1c2027; color: #a6b2c4; margin-right: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.2);\">Estimated cost</button><button type=\"button\" class=\"perf-pill\" data-perf=\"Errors\" onclick=\"setParam('var-conv_metric', 'Errors', event); return false;\" style=\"display: inline-flex; align-items: center; padding: 4px 14px; border-radius: 12px; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid #333842; background: #1c2027; color: #a6b2c4; margin-right: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.2);\">Errors</button>\n</div>\n<script>\nwindow.setParam = window.setParam || function(key, val, evt) {\n  if (evt) {\n    if (evt.preventDefault) evt.preventDefault();\n    if (evt.stopPropagation) evt.stopPropagation();\n  }\n  const cleanKey = key.replace(/^var-/, '');\n\n  try {\n    document.querySelectorAll('.perf-pill').forEach(el => {\n      const isMatch = el.getAttribute('data-perf') === val;\n      el.style.setProperty('background', isMatch ? '#2563eb' : '#1c2027', 'important');\n      el.style.setProperty('color', isMatch ? '#ffffff' : '#a6b2c4', 'important');\n      el.style.setProperty('border-color', isMatch ? '#3b82f6' : '#333842', 'important');\n      el.style.setProperty('font-weight', isMatch ? '700' : '600', 'important');\n    });\n  } catch(e) {}\n\n  try {\n    const sceneVars = window.__grafanaSceneContext?._state?.$variables?._state?.variables;\n    if (sceneVars) {\n      const targetVar = sceneVars.find(v => v._state?.name === cleanKey);\n      if (targetVar && typeof targetVar.changeValueTo === 'function') {\n        targetVar.changeValueTo(val);\n        return false;\n      }\n    }\n  } catch(e) {}\n\n  try {\n    const url = new URL(window.location);\n    url.searchParams.set('var-' + cleanKey, val);\n    if (window.history && window.history.pushState) {\n      window.history.pushState(null, '', url.toString());\n      window.dispatchEvent(new PopStateEvent('popstate'));\n      return false;\n    }\n  } catch(e) {}\n\n  const url = new URL(window.location);\n  url.searchParams.set('var-' + cleanKey, val);\n  window.location.href = url.toString();\n  return false;\n};\n</script>",
        "mode": "html"
      },
      "pluginVersion": "11.1.0",
      "transparent": true,
      "type": "text"
