          "editorMode": "code",
          "expr": "(sum by (gen_ai_agent_name)(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_agent_name!=\"\"}[$__range]))) or sum by (gen_ai_agent_name)(label_replace(increase(litellm_requests_metric_total[$__range]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\"))",
