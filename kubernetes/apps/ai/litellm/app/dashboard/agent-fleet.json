              "Value #TOKENS": "TOKENS",
              "Value #ESTIMATED COST": "ESTIMATED COST",
              "Value #ERROR RATE": "ERROR RATE",
              "Value #AVG LATENCY": "AVG LATENCY"
            }
          }
        }
      ],
      "type": "table"
    }
