          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (gen_ai_agent_name)(increase(gen_ai_client_token_usage_total{gen_ai_agent_name!=\"\"}[$__range]))) or sum by (gen_ai_agent_name)(label_replace(increase(litellm_total_tokens_metric_total[$__range]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "TOKENS"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (gen_ai_agent_name)(increase(gen_ai_usage_cost_USD_total{gen_ai_agent_name!=\"\"}[$__range]))) or sum by (gen_ai_agent_name)(label_replace(increase(litellm_spend_metric_total[$__range]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "ESTIMATED COST"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_max(((sum by (gen_ai_agent_name)(rate(gen_ai_client_operation_duration_seconds_count{gen_ai_agent_name!=\"\",error_type!=\"\"}[5m])) / (sum by (gen_ai_agent_name)(rate(gen_ai_client_operation_duration_seconds_count{gen_ai_agent_name!=\"\"}[5m])) + 0.001) * 100)) or ((sum by (gen_ai_agent_name)(label_replace(rate(litellm_requests_metric_total{status_code=~\"[45].*\"}[5m]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\")) / (sum by (gen_ai_agent_name)(label_replace(rate(litellm_requests_metric_total[5m]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\")) + 0.001) * 100)), 100)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "ERROR RATE"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "((histogram_quantile(0.50, sum by (le, gen_ai_agent_name)(increase(gen_ai_client_operation_duration_seconds_bucket{gen_ai_agent_name!=\"\"}[$__range]))) or histogram_quantile(0.50, sum by (le, gen_ai_agent_name)(label_replace(increase(litellm_request_total_latency_metric_bucket[$__range]), \"gen_ai_agent_name\", \"$1\", \"model\", \"(.*)\")))) >= 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "AVG LATENCY"
        }
      ],
      "title": "Agent Runtime & Generation Registry",
      "transformations": [
