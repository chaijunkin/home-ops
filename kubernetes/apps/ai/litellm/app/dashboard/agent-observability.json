{
  "title": "Agent Observability (OTel GenAI)",
  "uid": "agent-o11y",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Generation Volume & Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count[5m])) by (error_type, gen_ai_operation_name)",
          "legendFormat": "{{gen_ai_operation_name}} - Error: {{error_type}}"
        }
      ]
    },
    {
      "title": "P95 Latency by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model)(increase(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "title": "Token Usage (Input vs Output)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (gen_ai_token_type) (increase(gen_ai_client_token_usage_sum[5m]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "title": "Estimated Cost (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model) (increase(agento11y_generation_cost_usd_total[5m]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "title": "Agent Evaluation Pass Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (evaluator) (increase(agento11y_eval_scores_total{passed=\"true\"}[5m])) / sum by (evaluator) (increase(agento11y_eval_executions_total[5m]))",
          "legendFormat": "{{evaluator}} Pass Rate"
        }
      ]
    }
  ]
}
