        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "limit": 50,
          "query": "{ .gen_ai.tool.name != \"\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Recent Tool Calls & MCP Invocations (Click Trace to Inspect Payload)",
      "type": "table"
