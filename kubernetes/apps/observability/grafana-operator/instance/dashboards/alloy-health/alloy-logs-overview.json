      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d",
      "90d"
    ]
  },
  "timezone": "utc",
  "title": "Alloy / Logs Overview",
  "uid": "53c1ecddc3a1d5d4b8d6cd0c23676c31",
  "version": 1
}