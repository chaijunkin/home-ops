          "editorMode": "code",
          "expr": "(((sum((rate(mysql_perf_schema_events_statements_seconds_total{instance=~\"$instance\"}[$__rate_interval:]) or rate(pg_stat_statements_seconds_total{instance=~\"$instance\", datname=~\"$database\"}[$__rate_interval:])))) / (sum((rate(mysql_perf_schema_events_statements_total{instance=~\"$instance\"}[$__rate_interval:]) or rate(pg_stat_statements_calls_total{instance=~\"$instance\", datname=~\"$database\"}[$__rate_interval:]))))) * 1000)",
          "legendFormat": "Avg Query Duration",
          "range": true,
          "refId": "DurationAvg"
        }
