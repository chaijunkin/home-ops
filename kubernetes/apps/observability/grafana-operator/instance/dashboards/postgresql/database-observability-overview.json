      },
      "gridPos": {
        "h": 3,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "last_over_time((count((count by (schema, instance) (mysql_perf_schema_events_statements_total{instance=~\"$instance\"}) or count by (datname, instance) (pg_stat_statements_calls_total{instance=~\"$instance\"} or pg_stat_database_xact_commit{instance=~\"$instance\"}))))[$__range:])",
          "instant": true,
          "range": false,
