      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min(((sum((rate(mysql_perf_schema_events_statements_errors_total{instance=~\"$instance\"}[$__rate_interval:]) or rate(database_observability_pg_errors_total{instance=~\"$instance\"}[$__rate_interval:]) or rate(pg_stat_database_conflicts_deadlock{instance=~\"$instance\"}[$__rate_interval:])))) / (sum((rate(mysql_perf_schema_events_statements_total{instance=~\"$instance\"}[$__rate_interval:]) or (rate(pg_stat_statements_calls_total{instance=~\"$instance\", datname=~\"$database\"}[$__rate_interval:]) or rate(database_observability_pg_errors_total{instance=~\"$instance\"}[$__rate_interval:]) or 0.001))))) * 100, 0)",
          "legendFormat": "Query Errors %",
          "range": true,
          "refId": "ErrorRate"
        }
      ],
      "title": "Errors",
      "type": "timeseries"
    },
