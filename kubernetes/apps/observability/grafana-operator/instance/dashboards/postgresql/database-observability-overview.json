          "expr": "((sum by (queryid, datname, instance) (rate(pg_stat_statements_seconds_total{instance=~\"$instance\", datname=~\"$database\"}[$__rate_interval])) / clamp_min(sum by (queryid, datname, instance) (rate(pg_stat_statements_calls_total{instance=~\"$instance\", datname=~\"$database\"}[$__rate_interval])), 0.001)) or (sum by (digest, schema, instance) (rate(mysql_perf_schema_events_statements_seconds_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum by (digest, schema, instance) (rate(mysql_perf_schema_events_statements_total{instance=~\"$instance\"}[$__rate_interval])), 0.001))) * 1000",
