      "panels": [],
      "title": "Wait Events & Latency Bottlenecks",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "description": "Cumulative duration of wait events categorized by type (IO, Lock, Network, CPU/Engine). Length is proportional to the total bottleneck time.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "wait_event_type",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "displayName": "${__field.labels.wait_event_type}",
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Lock [Ww]ait.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(255, 152, 48, 1)",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Lock wait"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*IO [Ww]ait.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(87, 148, 242, 1)",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "IO wait"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Network [Ww]ait.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(184, 119, 217, 1)",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Network wait"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Engine [Ww]ait.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(0, 117, 143, 1)",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Engine wait"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Other [Ww]ait.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "rgba(115, 191, 105, 1)",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Other wait"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "editorMode": "code",
          "expr": "((((sum by (wait_event_type) (sum_over_time({job=~\"integrations/db-o11y|.*db-o11y.*\", op=\"wait_event_v2\"} | logfmt | (schema!=\"\" or datname!=\"\") | backend_type =~ \"^(client backend)?$\" | queryid != \"0\" | wait_time>=0ms | unwrap duration_seconds(wait_time)[$__auto]))) or (sum by (wait_event_type) (label_replace(label_replace(label_replace(sum_over_time({job=~\"integrations/db-o11y|.*db-o11y.*\", op=\"wait_event\"} | logfmt | (schema!=\"\" or datname!=\"\") | backend_type =~ \"^(client backend)?$\" | queryid != \"0\" | wait_time>=0ms | unwrap duration_seconds(wait_time)[$__auto]), \"wait_event_type\", \"IO Wait\", \"wait_event_type\", \"IO\"), \"wait_event_type\", \"Lock Wait\", \"wait_event_type\", \"Lock|LWLock|Activity|IPC\"), \"wait_event_type\", \"Network Wait\", \"wait_event_type\", \"Client\"))))) > 0)",
          "legendFormat": "{{wait_event_type}}",
          "maxDataPoints": 50,
          "refId": "WaitEvents"
        }
      ],
      "title": "Cumulative duration of wait events by group / type",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
